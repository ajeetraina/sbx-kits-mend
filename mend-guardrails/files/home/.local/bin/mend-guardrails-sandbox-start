#!/bin/sh
set -eu

export PATH="${HOME}/.local/bin:/usr/local/bin:${PATH:-}"

# SDK reads MEND_KEY. Alias is for hosts that already export another Mend key.
if [ -z "${MEND_KEY:-}" ] && [ -n "${MEND_GUARDRAILS_KEY:-}" ]; then
  export MEND_KEY="$MEND_GUARDRAILS_KEY"
fi

# Kit env points Codex at loopback. The OpenAI SDK also reads OPENAI_BASE_URL
# as the *upstream*; leaving it set would make this process proxy to itself.
unset OPENAI_BASE_URL
# Prefer the per-request forwarded sentinel over a process-wide key.
unset OPENAI_API_KEY

# This process must use the sandbox HTTP proxy for provider upstream.
_without_openai_noproxy() {
  in="${1-},"
  out=""
  while [ -n "$in" ]; do
    p=${in%%,*}
    rest=${in#"$p"}
    in=${rest#,}
    # trim leading/trailing spaces
    while [ -n "$p" ] && [ "${p# }" != "$p" ]; do
      p=${p# }
    done
    while [ -n "$p" ] && [ "${p% }" != "$p" ]; do
      p=${p% }
    done
    case "$p" in
      api.openai.com|openai.com|.openai.com|'*.openai.com') continue ;;
      '') continue ;;
    esac
    if [ -n "$out" ]; then
      out="${out},${p}"
    else
      out="${p}"
    fi
  done
  printf '%s' "$out"
}

if [ -n "${NO_PROXY:-}" ]; then
  NO_PROXY="$(_without_openai_noproxy "$NO_PROXY")"
  export NO_PROXY
fi
if [ -n "${no_proxy:-}" ]; then
  no_proxy="$(_without_openai_noproxy "$no_proxy")"
  export no_proxy
fi

# Startup does not gate the agent entrypoint. Callers (and mend-guard-text)
# retry /health. This process *is* the server.
# Default is online (policy-source api). Local sandbox.json is opt-in and
# requires offline — the SDK rejects local files in online mode.
policy_source="${MEND_GUARDRAILS_POLICY_SOURCE:-api}"
offline="${MEND_GUARDRAILS_OFFLINE:-false}"
case "$offline" in
  true|TRUE|1) offline_on=1 ;;
  *) offline_on=0 ;;
esac
case "$policy_source" in
  local)
    export MEND_GUARDRAILS_OFFLINE=true
    ;;
  api)
    if [ "$offline_on" -eq 1 ]; then
      echo "mend-guardrails: policySource=api cannot be combined with offline=true" >&2
      exit 1
    fi
    ;;
  *)
    echo "mend-guardrails: unknown MEND_GUARDRAILS_POLICY_SOURCE='$policy_source' (use local or api)" >&2
    exit 1
    ;;
esac

exec mend-guardrails-server \
  --host 127.0.0.1 \
  --port 8787 \
  --policy-dir "${MEND_GUARDRAILS_POLICY_DIR:-/home/agent/.mend-guardrails/policies}" \
  --default-config "${MEND_GUARDRAILS_DEFAULT_CONFIG_ID:-sandbox}" \
  --name "${MEND_GUARDRAILS_INSTANCE_NAME:-docker-sandbox}" \
  --policy-source "$policy_source"
