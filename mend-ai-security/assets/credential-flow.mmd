%% Mend credentials in the sandbox: why -e, not the secret manager (verified live)
%% Rendered to credential-flow.svg. Edit here, then re-render.
flowchart TB
    subgraph A["✅ How the secret manager normally works (other services)"]
        direction LR
        a1["Sandbox<br/>(sees placeholder only)"] --> a2["Proxy swaps real key<br/>into the HEADER"]
        a2 --> a3["Service reads key<br/>from the HEADER"]
        a3 --> a4["✅ Login works<br/>(key never in sandbox)"]
    end

    subgraph B["❌ Same approach with Mend"]
        direction LR
        b1["Sandbox<br/>(sees placeholder)"] --> b2["Proxy swaps real key<br/>into the HEADER"]
        b2 --> b3["But Mend reads its key<br/>from the BODY, not the header"]
        b3 --> b4["Mend gets the placeholder<br/>from the body → Unauthorized"]
    end

    subgraph C["✅ What we ship today: -e"]
        direction LR
        c1["Pass key with<br/>-e MEND_USER_KEY=..."] --> c2["Key lands in the env →<br/>Mend sends it in the BODY"]
        c2 --> c3["✅ Login works<br/>(trade-off: key readable in sandbox)"]
    end

    note["Verified live: the proxy's TLS interception is NOT the problem —<br/>auth succeeds through the same MITM when the key rides in the body (-e).<br/>Header-only substitution is the sole blocker."]

    A --> B --> C --> note
