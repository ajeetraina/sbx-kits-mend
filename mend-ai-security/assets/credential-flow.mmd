%% Mend credentials in the sandbox: why -e, not the secret manager
%% Rendered to credential-flow.svg. Edit here, then re-render.
flowchart TB
    subgraph A["✅ How the secret manager normally works (other services)"]
        direction LR
        a1["Sandbox<br/>(sees placeholder only)"] --> a2["Proxy swaps real key<br/>into the HEADER"]
        a2 --> a3["Service reads key<br/>from HEADER"]
        a3 --> a4["✅ Login works<br/>(key never in sandbox)"]
    end
    subgraph B["❌ Same approach with Mend"]
        direction LR
        b1["Sandbox"] --> b2["Proxy swaps key<br/>into the HEADER"]
        b2 --> b3["But Mend puts its key<br/>in the BODY, not header"]
        b3 --> b4["Mend sees only the<br/>placeholder → Unauthorized"]
        b2 -.->|"to swap, proxy must<br/>intercept traffic"| b5["Interception also breaks<br/>Mend's login handshake"]
        b5 --> b4
    end
    subgraph C["✅ What we ship today: -e"]
        direction LR
        c1["Pass key with<br/>-e MEND_USER_KEY=..."] --> c2["Mend's own login<br/>reads it from the body"]
        c2 --> c3["✅ Login works<br/>(trade-off: key readable in sandbox)"]
    end
    A --> B --> C
